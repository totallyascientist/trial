{
  "name": "tas-paddock-editorial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "node scripts/check-site.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/styles.css\" \"index.html\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/styles.css\" \"index.html\" \"README.md\""
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "prettier": "^3.5.3"
  }
}
